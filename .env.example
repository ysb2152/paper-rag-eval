# 환경변수 예시. 실제 값은 .env 에 넣는다(.gitignore 13행으로 제외됨).
# 이 파일에는 절대 실제 키를 적지 않는다.

# 생성 백엔드의 OpenAI 호환 엔드포인트.
#   로컬 vLLM  : http://localhost:8000/v1   (app.py 의 기본값)
#   Groq       : https://api.groq.com/openai/v1
# 이름은 B-25 당시 vLLM 전용이라 붙었지만 지금은 OpenAI 호환 엔드포인트 일반을 가리킨다.
VLLM_BASE_URL=http://localhost:8000/v1

# 생성 모델 ID. 백엔드마다 다르다.
#   로컬 vLLM  : Qwen/Qwen2.5-7B-Instruct-AWQ
#   Groq       : Groq 콘솔 Models 페이지의 정확한 ID 문자열을 확인해 넣는다
#                (대시보드의 표시 이름 "GPT OSS 20B" 는 API ID 가 아니다)
LLM_MODEL=

# 생성 백엔드 API 키. 공급자에 중립적인 이름을 쓴다 — 코드가 base_url 로 백엔드를 고르므로
# 키 이름에 공급자를 박으면 로컬 vLLM 을 쓸 때 어색해진다.
# 로컬 vLLM 은 값을 검사하지 않지만 OpenAI 클라이언트가 빈 값을 거부하므로 더미 문자열이라도 넣는다.
# 코드에 기본값을 두지 않는다 — 안 넣으면 바로 에러를 내는 편이 401 을 디버깅하는 것보다 낫다.
LLM_API_KEY=

# 추론 모델(gpt-oss 계열)의 추론 토큰 예산. 비워 두면 요청에 넣지 않으므로
# 이 파라미터를 모르는 백엔드(로컬 vLLM 등)에는 영향이 없다.
# gpt-oss-20b 실측: 기본값은 medium 과 사실상 같고, low 가 추론 토큰을 약 3분의 1로 줄이면서
# 답 품질은 떨어지지 않았다. high 는 토큰만 2배 늘었다.
LLM_REASONING_EFFORT=
